# Public addresses and chain metadata belong in config/networks.json.
# Run from contracts/. Never commit private keys or private RPC credentials.
PROTOCOL_CONFIG=../config/networks.json
PROTOCOL_NETWORK_INDEX=0
RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=<local-or-testnet-key>
AIRDROP_WALLET=<address>
COMMUNITY_FUND=<address>
DEV_FUND=<address>
TIMELOCK_ADMIN=<address>
TIMELOCK_DELAY=86400
# EPOCH_START and VESTING_START default to now + 1 hour. Set explicit future
# timestamps for a reviewed launch; leave enough time for setup and governance.
# EPOCH_START=<unix-seconds>
# VESTING_START=<unix-seconds>
# Permissionless keeper signer with gas only; configured separately in CI.
# KEEPER_PRIVATE_KEY=<key>
# BASE_RPC_URL=<optional-public-or-private-RPC-for-historical-Base-fork-tests>
