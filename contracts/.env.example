# Old Money — environment variables
# Copy to .env and fill in. .env is gitignored — DO NOT commit secrets.
# ETHSKILLS reminder: "Bots exploit leaked secrets in seconds."

# ---- RPC endpoints ----
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://eth.llamarpc.com
# Note: eth.llamarpc.com (no subdomain) is ETH MAINNET. For ETH Sepolia use one of:
#   https://rpc.sepolia.org
#   https://ethereum-sepolia.publicnode.com
#   https://sepolia.gateway.tenderly.co
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# ---- Block explorer verification ----
BASESCAN_API_KEY=your_basescan_api_key_here

DEPLOYER_PRIVATE_KEY=<key_with_sepolia_eth>

# Three addresses you control — can be the same for now (testnet),
# but on mainnet these should be separate multisigs
AIRDROP_WALLET=<your_address>
COMMUNITY_FUND=<your_address>
DEV_FUND=<your_address>     # Note: this address also rotates community/dev funds

# ---- Deploy signer ----
# Prefer a hardware wallet via `--ledger` or `--trezor` over a raw PK.
# If you must use a PK for local/Sepolia, set DEPLOYER_PRIVATE_KEY here.
# DEPLOYER_PRIVATE_KEY=0x...

# ---- Foundry profile (optional) ----
# FOUNDRY_PROFILE=ci   # use 'ci' for stricter fuzz/invariant runs
# FOUNDRY_PROFILE=deep # use pre-audit for 10k-run invariant sweep
