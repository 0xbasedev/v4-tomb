{
  "name": "xtomb-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:demo": "VITE_ROUTER=memory VITE_PREVIEW=1 vite build --base ./ --outDir dist-demo",
    "test:browser": "playwright test",
    "test:model": "playwright test --project=model",
    "gen:abis": "node scripts/gen-abis.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource-variable/jetbrains-mono": "5.2.6",
    "@fontsource-variable/unbounded": "5.2.6",
    "@gsap/react": "2.1.2",
    "@tanstack/react-query": "^5.59.0",
    "gsap": "3.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "viem": "^2.21.0",
    "wagmi": "^2.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "keccak",
      "esbuild"
    ]
  }
}
